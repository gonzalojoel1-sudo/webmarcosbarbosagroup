# Copy to .env for local dev, or set these in Dokploy (encrypted).
# Never commit real values.

# Mercado Pago (Tus integraciones → Credenciales de producción)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_ENV=production

# Site (used for back_urls / notification_url)
NEXT_PUBLIC_SITE_URL=https://marcosbarbosagroup.com

# Persistence (default /app/data in Docker)
DONATIONS_DATA_DIR=/app/data

# Panel interno (ver búsquedas y CVs de Los 1000 Socios) — Basic Auth
ADMIN_USER=
ADMIN_PASS=

# Transferencia / alias (shown on the donation page)
NEXT_PUBLIC_TRANSFER_ALIAS=
NEXT_PUBLIC_TRANSFER_CVU=
NEXT_PUBLIC_TRANSFER_HOLDER=

# Existing CRM integration (unchanged)
NEXT_PUBLIC_CRM_URL=
CRM_API_KEY=
CRM_API_SECRET=

# Confesionario — cifrado en reposo
# ⚠ BACKUPEAR aparte. Si se pierde, los mensajes son irrecuperables.
# Generar con: openssl rand -base64 32
CONFESSIONS_ENCRYPTION_KEY=
# Generar con: openssl rand -hex 16
CONFESSIONS_IP_SALT=

# Pastor Login — sesión propia
# ⚠ Sesión del panel interno. NO compartir con CONFESSIONS_ENCRYPTION_KEY.
# Generar con: openssl rand -base64 32
ADMIN_SESSION_KEY=
# Contraseña del pastor/administrador único. Hasheada en memoria al boot con scrypt.
# Cambiar acá y redeploy para rotar.
ADMIN_PASS=
# Username mostrado en el form (no se verifica — single-pastor). Default: "admin"
ADMIN_USER=
