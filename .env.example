# Copy to .env for local dev, or set these in Dokploy (encrypted).
# Never commit real values.

# Mercado Pago (Tus integraciones → Credenciales de producción)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_ENV=production

# Site (used for back_urls / notification_url)
NEXT_PUBLIC_SITE_URL=https://marcosbarbosagroup.com

# Persistence (default /app/data in Docker)
DONATIONS_DATA_DIR=/app/data

# Transferencia / alias (shown on the donation page)
NEXT_PUBLIC_TRANSFER_ALIAS=
NEXT_PUBLIC_TRANSFER_CVU=
NEXT_PUBLIC_TRANSFER_HOLDER=

# Existing CRM integration (unchanged)
NEXT_PUBLIC_CRM_URL=
CRM_API_KEY=
CRM_API_SECRET=
